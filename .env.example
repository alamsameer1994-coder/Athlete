# Copy to .env and fill in.

# Strava API app: create at https://www.strava.com/settings/api
# Authorization Callback Domain must be: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8721/callback

# Your own Garmin Connect login. Used only locally via the unofficial
# garminconnect library to pull your own data — never sent anywhere else.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# MyFitnessPal has no login API left (username/password no longer works for
# third-party scripts) — you authenticate by copying your browser's session
# cookie. While logged into myfitnesspal.com: open DevTools > Network, click
# any request to myfitnesspal.com, and copy the entire "Cookie" request
# header value (Firefox/Chrome both show this under Headers). Paste it here
# as one line. It will need to be refreshed periodically as the session
# cookie expires (typically a few weeks).
MFP_COOKIE=

# Where the local SQLite DB + cached tokens live (default: ~/.athlete_coach)
# ATHLETE_COACH_HOME=/custom/path
# ATHLETE_COACH_DB_PATH=/custom/path/athlete.db
ATHLETE_COACH_TZ=Europe/London
